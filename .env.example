# MongoDB
MONGODB_URI=

# Admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# App URL for the site itself (local browsing can stay on localhost):
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Live site origin (optional; use when not on localhost):
# NEXT_PUBLIC_APP_URL=https://cult-theta.vercel.app

# Atom return/callback origin — MUST be public HTTPS for real UAT tests.
# Atom posts to: {NTTDATA_RETURN_APP_URL}/api/payments/nttdata/callback
# Use the deployed HTTPS origin (or a tunnel). Whitelist with NDPS for MID 446442.
NTTDATA_RETURN_APP_URL=https://www.cultscribe.com

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DELIVERY_AGENCY_NAME=
DELIVERY_AGENCY_EMAIL=

# NTT DATA Payment Services — UAT ONLY (server-side; never NEXT_PUBLIC_)
# Production env/hosts are rejected by the app.
NTTDATA_ENV=uat
NTTDATA_PAYMENT_URL=https://paynetzuat.atomtech.in/ots/aipay/auth
NTTDATA_STATUS_URL=https://paynetzuat.atomtech.in/ots/payment/status
NTTDATA_CHECKOUT_JS_URL=https://pgtest.atomtech.in/staticdata/ots/js/atomcheckout.js
NTTDATA_MERCHANT_ID=
NTTDATA_TRANSACTION_PASSWORD=
NTTDATA_PRODUCT=NSE
NTTDATA_REQUEST_ENCRYPTION_KEY=
NTTDATA_RESPONSE_ENCRYPTION_KEY=
NTTDATA_REQUEST_HASH_KEY=
NTTDATA_RESPONSE_HASH_KEY=
